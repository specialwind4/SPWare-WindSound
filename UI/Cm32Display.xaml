<UserControl x:Class="SPWare.VirtualSoundCanvas.UI.Cm32Display"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:SPWare.VirtualSoundCanvas.UI"
             mc:Ignorable="d"
             d:DesignWidth="670" d:DesignHeight="128">

    <!-- SPE3L 앞판(좌표는 캔버스 670 x 128 기준): 베이지색 본체 / 왼쪽 위 SPWare SPE3L SOUND MODULE / VOLUME 노브(회색) /
         세로 리브(통풍구) 줄 / MIDI MESSAGE(초록) · POWER(빨강) 램프 / 회색 전원 스위치.
         액정도 버튼도 없다. 전원 스위치는 그림일 뿐이고(엔진은 시작/탭으로 다룬다), 램프만 실제 상태를 따른다. -->
    <UserControl.Resources>
        <!-- 세로 리브: 밝은 이빨(1.8) + 어두운 홈(1.0), 주기 2.8 -->
        <DrawingBrush x:Key="Ribs" TileMode="Tile" Viewport="0,0,2.8,20" ViewportUnits="Absolute"
                      Viewbox="0,0,2.8,20" ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#A39D82">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,2.8,20"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#D4CEB7">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,1.8,20"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- 본체에 새겨진(회색) 글자 -->
        <SolidColorBrush x:Key="Silk" Color="#625F58"/>
        <Style x:Key="SilkLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Silk}"/>
            <Setter Property="FontFamily" Value="Bahnschrift"/>
        </Style>
    </UserControl.Resources>

    <Viewbox Stretch="Uniform" StretchDirection="Both" MaxWidth="960" HorizontalAlignment="Center">
        <Canvas Width="670" Height="128">

            <!-- 본체: 위쪽 모서리 둥글게, 아래쪽은 거의 직각. 위가 밝고 아래로 갈수록 어두운 베이지 -->
            <Border Canvas.Left="8" Canvas.Top="16" Width="654" Height="106" CornerRadius="7,7,3,3">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#E3DDCC" Offset="0"/>
                        <GradientStop Color="#DCD5C4" Offset="0.07"/>
                        <GradientStop Color="#D6CFBD" Offset="0.20"/>
                        <GradientStop Color="#CBC6B2" Offset="0.55"/>
                        <GradientStop Color="#C2BDA6" Offset="0.80"/>
                        <GradientStop Color="#B9B496" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="9" ShadowDepth="3" Direction="270" Opacity="0.55"/>
                </Border.Effect>
            </Border>

            <!-- 윗면 모서리의 밝은 띠 -->
            <Border Canvas.Left="8" Canvas.Top="16" Width="654" Height="5" CornerRadius="7,7,0,0" Background="#ECE7D8" Opacity="0.85"/>

            <!-- 통풍구 줄: 위 면과 아래 턱 사이에 파인 세로 리브 -->
            <Rectangle Canvas.Left="8" Canvas.Top="87" Width="654" Height="13" Fill="{StaticResource Ribs}"/>
            <Rectangle Canvas.Left="8" Canvas.Top="86" Width="654" Height="1.5" Fill="#8F8A72" Opacity="0.75"/>
            <Rectangle Canvas.Left="8" Canvas.Top="100" Width="654" Height="1" Fill="#E2DCC9" Opacity="0.8"/>
            <Rectangle Canvas.Left="8" Canvas.Top="87" Width="654" Height="3" Opacity="0.35">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#000000" Offset="0"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- 노브가 들어가는 홈: 위 면이 이 구간만 위쪽까지 파여 있고 안쪽이 리브로 채워져 있다 -->
            <Rectangle Canvas.Left="222" Canvas.Top="56" Width="53" Height="32" Fill="{StaticResource Ribs}"/>
            <Rectangle Canvas.Left="222" Canvas.Top="56" Width="53" Height="32" Opacity="0.30">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#000000" Offset="0"/>
                        <GradientStop Color="#00000000" Offset="0.5"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle Canvas.Left="221.5" Canvas.Top="56" Width="1" Height="31" Fill="#8A856E"/>
            <Rectangle Canvas.Left="275" Canvas.Top="62" Width="1" Height="25" Fill="#8A856E"/>

            <!-- 실크스크린: SPWare / SPE3L / SOUND MODULE -->
            <TextBlock Canvas.Left="20" Canvas.Top="26" Text="SPWare" Style="{StaticResource SilkLabel}"
                       FontFamily="Arial Rounded MT Bold, Segoe UI" FontSize="16"/>
            <TextBlock x:Name="ModelName" Canvas.Left="98" Canvas.Top="24" Text="SPE3L" Style="{StaticResource SilkLabel}"
                       FontWeight="SemiBold" FontSize="21">
                <TextBlock.LayoutTransform>
                    <ScaleTransform ScaleX="1.32" ScaleY="1"/>
                </TextBlock.LayoutTransform>
            </TextBlock>
            <TextBlock x:Name="ModelSub" Canvas.Left="100" Canvas.Top="46.5" Text="SOUND MODULE" Style="{StaticResource SilkLabel}"
                       FontWeight="SemiBold" FontSize="6.4">
                <TextBlock.LayoutTransform>
                    <ScaleTransform ScaleX="1.78" ScaleY="1"/>
                </TextBlock.LayoutTransform>
            </TextBlock>

            <!-- VOLUME 글씨(노브 오른쪽 위로 기울어짐) -->
            <TextBlock Canvas.Left="279" Canvas.Top="68" Text="VOLUME" Style="{StaticResource SilkLabel}" FontSize="6.6"
                       RenderTransformOrigin="0,1">
                <TextBlock.RenderTransform>
                    <RotateTransform Angle="-38"/>
                </TextBlock.RenderTransform>
            </TextBlock>

            <!-- 볼륨 노브: 회색 원통. 아래쪽 옆면(어두운 원)을 한 겹 깔고 그 위에 윗면 -->
            <Ellipse Canvas.Left="219.5" Canvas.Top="32.5" Width="52" Height="52" Fill="#34373B">
                <Ellipse.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="7" ShadowDepth="3" Direction="270" Opacity="0.45"/>
                </Ellipse.Effect>
            </Ellipse>
            <ui:VolumeKnob x:Name="Knob" Canvas.Left="219.5" Canvas.Top="29" Width="52" Height="52"/>
            <Ellipse Canvas.Left="219.5" Canvas.Top="29" Width="52" Height="52" IsHitTestVisible="False" StrokeThickness="1.6">
                <Ellipse.Stroke>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#9A9DA1" Offset="0"/>
                        <GradientStop Color="#5E6165" Offset="0.5"/>
                        <GradientStop Color="#3A3D41" Offset="1"/>
                    </LinearGradientBrush>
                </Ellipse.Stroke>
            </Ellipse>

            <!-- MIDI MESSAGE / POWER 글씨 -->
            <TextBlock Canvas.Left="511" Canvas.Top="70" Text="MIDI MESSAGE" Style="{StaticResource SilkLabel}" FontSize="6.8"
                       RenderTransformOrigin="0,1">
                <TextBlock.RenderTransform>
                    <RotateTransform Angle="-43"/>
                </TextBlock.RenderTransform>
            </TextBlock>
            <TextBlock Canvas.Left="546" Canvas.Top="70" Text="POWER" Style="{StaticResource SilkLabel}" FontSize="6.8"
                       RenderTransformOrigin="0,1">
                <TextBlock.RenderTransform>
                    <RotateTransform Angle="-43"/>
                </TextBlock.RenderTransform>
            </TextBlock>

            <!-- 램프: 리브 하나 자리를 차지한다. 꺼졌을 때는 연한 색, 켜지면 사진의 초록/빨강 + 은은한 번짐 -->
            <Rectangle x:Name="MidiLed" Canvas.Left="510" Canvas.Top="83" Width="5.5" Height="9" Fill="#93AE63"/>
            <Rectangle x:Name="PowerLed" Canvas.Left="545" Canvas.Top="83" Width="5.5" Height="9" Fill="#B9707A"/>

            <!-- 전원 스위치: 리브 줄에 파인 어두운 홈 안의 누름 잠금 버튼(홈 둘레는 본체 색 그대로) -->
            <Rectangle x:Name="SwitchHollow" Canvas.Left="563" Canvas.Top="81.5" Width="44" Height="13" Fill="#2B2A24" RadiusX="1" RadiusY="1"/>
            <Border x:Name="SwitchBar" Canvas.Left="566" Canvas.Top="83" Width="38" Height="10" CornerRadius="2" BorderThickness="1" BorderBrush="#4D4F51">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#9A9C9E" Offset="0"/>
                        <GradientStop Color="#808284" Offset="0.5"/>
                        <GradientStop Color="#66686A" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="3" ShadowDepth="1.5" Direction="300" Opacity="0.5"/>
                </Border.Effect>
            </Border>
            <!-- 스위치를 누르는 자리(투명): 누를 때마다 SPE3 엔진을 끄고 켠다(누름 잠금 버튼: 눌려 들어가 있으면 켜짐, 튀어나와 있으면 꺼짐) -->
            <Rectangle x:Name="SwitchHit" Canvas.Left="556" Canvas.Top="81.5" Width="52" Height="13" Fill="Transparent" Cursor="Hand"
                       ToolTip="전원 스위치 - 누르면 SPE3 엔진을 끄고 켭니다 (켤 때는 처음 상태로 시작)"/>
        </Canvas>
    </Viewbox>
</UserControl>
