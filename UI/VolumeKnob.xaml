<UserControl x:Class="SPWare.VirtualSoundCanvas.UI.VolumeKnob"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="40" Height="40" Cursor="Hand">

    <!-- 볼륨 노브: 실기 MTS3의 SELECT/VOLUME 노브는 무광 검정 원통에 흰 표시선 하나뿐인 밋밋한 모양이다.
         표시선 층이 -135도(1) ~ +135도(100)를 돈다. 조작은 VolumeKnob.xaml.cs 참고 -->
    <Grid x:Name="Root" Background="Transparent">
        <Ellipse Fill="#161618" Stroke="#2C2C30" StrokeThickness="1"/>
        <!-- 표시선 층: 노브 전체 크기의 층을 가운데 기준으로 돌린다(크기에 상관없이 같은 코드로 동작) -->
        <Grid RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <RotateTransform x:Name="Rotate" Angle="135"/>
            </Grid.RenderTransform>
            <Rectangle Width="2" Height="9" Fill="#E8E8EC"
                       VerticalAlignment="Top" Margin="0,3,0,0"/>
        </Grid>
    </Grid>
</UserControl>
