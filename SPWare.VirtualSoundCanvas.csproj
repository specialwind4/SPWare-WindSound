<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <RootNamespace>SPWare.VirtualSoundCanvas</RootNamespace>
    <AssemblyName>SPWare.WindSound</AssemblyName>
    <Platforms>x64</Platforms>

    <!-- 아이콘 및 버전 정보: exe/작업표시줄/속성창에 그대로 반영됩니다 -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.0.3</Version>
    <FileVersion>1.0.3.0</FileVersion>
    <Product>SPWare Wind Sound</Product>
    <Company>SPWare (Special Wind Software)</Company>
    <Copyright>Copyright © SPWare (Special Wind Software)</Copyright>

    <!-- dotnet publish 시 exe 하나로 묶어서 배포하기 위한 옵션 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!--
      NAudio: 엔진이 만들어낸 오디오 샘플을 실제 스피커(WASAPI)로 내보내는 재생 루프에 씁니다.
      MIT 라이선스, 아주 널리 쓰이는 검증된 패키지입니다. (https://github.com/naudio/NAudio)
      버전을 못 박아둔 이유: 최신 버전(3.x)이 .NET 9 전용으로 넘어가서 이 프로젝트의
      .NET 8과 호환되지 않습니다. 2.2.1은 .NET 8과 호환되는 마지막 안정 버전 계열입니다.
    -->
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <!--
      mt32_wrap.dll 은 munt/munt 저장소의 mt32emu 폴더에 추가된 mt32_wrap 타깃을
      CMake로 빌드하면 나옵니다(Munt.NET 대신 - LCD 텍스트 조회 기능이 없어서
      mt32emu 본체를 직접 감쌌습니다). 완성되면 Native\x64\ 에 넣으세요.
        cmake -B build -G "Visual Studio 17 2022" -A x64
        cmake ‑‑build build ‑‑config Release ‑‑target mt32_wrap
    -->
    <None Include="Native\x64\mt32_wrap.dll" Condition="Exists('Native\x64\mt32_wrap.dll')">
      <Link>mt32_wrap.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!--
      nuked_sc55_wrap.dll 은 Nuked-SC55(https://github.com/nukeykt/Nuked-SC55) 소스 위에
      Sc55Engine.cs가 기대하는 함수들(sc55_create 등)을 export하는 얇은 C/C++ 래퍼를
      직접 빌드해서 만들어야 합니다. 완성되면 Native\x64\ 에 넣으세요.
    -->
    <None Include="Native\x64\nuked_sc55_wrap.dll" Condition="Exists('Native\x64\nuked_sc55_wrap.dll')">
      <Link>nuked_sc55_wrap.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- 다른 PC로 publish 폴더를 통째로 복사해 갔을 때, 거기서 바탕화면 아이콘(바로가기)을 만들 수 있게 발행 폴더에 같이 넣는다 -->
    <None Include="create_desktop_shortcut.bat" CopyToPublishDirectory="PreserveNewest" />
    <!-- 실행 중 창/작업표시줄 아이콘용 (ApplicationIcon은 exe 파일 자체의 아이콘만 담당) -->
    <Resource Include="Assets\app.ico"/>
    <!--
      ROM 파일은 저작물이라 빌드/배포에 담지 않는다(이 프로젝트 폴더의 Roms\ 는 개발자 PC의
      테스트용일 뿐, csproj가 일부러 안 담는다). 받는 사람은 각자 ROM을 구해서 설정 화면의
      "찾아보기"로 직접 폴더를 지정한다(그 경로는 settings.json에 저장됨 - Config/AppSettings.cs
      참고). PublishSingleFile이 큰 ROM 파일을 조용히 빠뜨리는 문제(§2.56)가 있었는데, ROM을
      애초에 빌드에 안 담으면 그 문제 자체가 안 생긴다.
    -->
  </ItemGroup>

</Project>
