<Window x:Class="SPWare.VirtualSoundCanvas.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:SPWare.VirtualSoundCanvas.UI"
        Title="SPWare Wind Sound" Height="700" Width="750" MinWidth="750" MinHeight="300" SizeToContent="Height"
        Icon="Assets/app.ico"
        FontFamily="Segoe UI" Foreground="#E8E8ED">

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1C1C22" Offset="0"/>
            <GradientStop Color="#121216" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#6C63FF"/>
        <SolidColorBrush x:Key="AccentLight" Color="#9089FF"/>
        <SolidColorBrush x:Key="CardBg" Color="#22222A"/>
        <SolidColorBrush x:Key="CardBorder" Color="#34343F"/>
        <SolidColorBrush x:Key="FieldBg" Color="#2A2A34"/>
        <SolidColorBrush x:Key="FieldBorder" Color="#3C3C48"/>
        <SolidColorBrush x:Key="TextMain" Color="#E8E8ED"/>
        <SolidColorBrush x:Key="TextMuted" Color="#9A9AA6"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CFCFD6"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentLight}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- 접었다 펼 수 있는 섹션: 제목을 누르면 내용이 접히고, 화살표가 돌아간다 -->
        <Style x:Key="SectionExpander" TargetType="Expander">
            <Setter Property="IsExpanded" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton x:Name="Head" Cursor="Hand" Focusable="False"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <StackPanel Orientation="Horizontal">
                                                <Path x:Name="Arrow" Data="M0,0 L4,4 L0,8" Stroke="{StaticResource AccentLight}"
                                                      StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round" VerticalAlignment="Center" Margin="2,0,9,0"
                                                      RenderTransformOrigin="0.4,0.5">
                                                    <Path.RenderTransform>
                                                        <RotateTransform Angle="0"/>
                                                    </Path.RenderTransform>
                                                </Path>
                                                <TextBlock Text="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}"
                                                           Style="{StaticResource SectionTitle}" Margin="0"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Arrow" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="90"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="Body" Margin="0,10,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="Body" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 도움말 글꼴 -->
        <Style x:Key="HelpHead" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentLight}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Margin" Value="0,14,0,5"/>
        </Style>
        <Style x:Key="HelpBody" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B4B4C0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="LineHeight" Value="19"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- 머리글만 따로 두는 섹션용: 제목 줄은 SectionToggle 버튼이 맡고, 이 Expander는 본문만 보였다 감췄다 한다 -->
        <Style x:Key="BodyOnlyExpander" TargetType="Expander">
            <Setter Property="IsExpanded" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <ContentPresenter x:Name="Body" Visibility="Collapsed"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="Body" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 제목 줄 버튼("설정" / "도움말"): 화살표 + 제목, 눌려 있으면 화살표가 아래로 -->
        <Style x:Key="SectionToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent">
                            <StackPanel Orientation="Horizontal">
                                <Path x:Name="Arrow" Data="M0,0 L4,4 L0,8" Stroke="{StaticResource AccentLight}"
                                      StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" VerticalAlignment="Center" Margin="2,0,9,0"
                                      RenderTransformOrigin="0.4,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="0"/>
                                    </Path.RenderTransform>
                                </Path>
                                <TextBlock Text="{TemplateBinding Content}" Style="{StaticResource SectionTitle}" Margin="0"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Arrow" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="90"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="2,0,0,4"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentLight}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EngineTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="7" Background="Transparent" Margin="2" Padding="0,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#33333F"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 드롭다운 목록 항목 -->
        <Style x:Key="ComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="4" Margin="3,1">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3A52"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
          ComboBox 전체 템플릿을 직접 정의합니다.
          기본 템플릿은 시스템 색(밝은 배경 + 검은 글씨)을 쓰기 때문에 다크 테마에서
          선택한 항목 글자가 배경에 묻혀 안 보이는 문제가 생깁니다.
        -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ComboItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Field"
                                                Background="{StaticResource FieldBg}"
                                                BorderBrush="{StaticResource FieldBorder}"
                                                BorderThickness="1" CornerRadius="6">
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,0,11,0" Data="M0,0 L9,0 L4.5,5.5 Z"
                                                  Fill="#9A9AA6"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Field" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- 선택된 항목 표시. TextElement.Foreground를 명시해야 글자가 보입니다 -->
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="11,0,30,0" VerticalAlignment="Center"
                                              TextElement.Foreground="{StaticResource TextMain}"/>

                            <Popup x:Name="Popup" Placement="Bottom" Focusable="False"
                                   AllowsTransparency="True" PopupAnimation="Fade"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="#262630" BorderBrush="{StaticResource FieldBorder}"
                                        BorderThickness="1" CornerRadius="6" Margin="0,3,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="260">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="3" Opacity="0.5"/>
                                    </Border.Effect>
                                    <ScrollViewer>
                                        <StackPanel IsItemsHost="True" Margin="0,3"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PathBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource FieldBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="34"/>
        </Style>

        <!--
          ScrollBar를 다크 테마에 맞게 다시 그립니다. 기본 스크롤바는 시스템 흰색이라
          어두운 배경 옆에서 혼자 튀어 보였습니다.
        -->
        <Style x:Key="DarkScrollBarThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#4A4A58" CornerRadius="4" Margin="2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="{x:Type ScrollBar}" TargetType="ScrollBar">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Background="Transparent" BorderThickness="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Background="Transparent" BorderThickness="0"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource DarkScrollBarThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- 스크롤할 게 없으면 막대는 감추되 폭(12)은 유지: 내용이 좌우로 출렁이지 않게 -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PART_Track" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 세로 스크롤바 자리를 항상 확보(Visible)하고 오른쪽 여백은 그만큼 줄여서, 좌우 여백이 같게 보인다 -->
    <ScrollViewer VerticalScrollBarVisibility="Visible" Padding="18,18,6,18">
        <StackPanel>

            <!-- 표시할 장치 선택 -->
            <Border Style="{StaticResource Card}" Padding="2" Margin="0,0,0,8" CornerRadius="9">
                <UniformGrid x:Name="EngineTabGrid" Columns="2"/>
            </Border>

            <!-- 장치별 실기 디스플레이 (한 번에 하나만 표시) -->
            <Grid Margin="0,0,0,12">
                <ui:Mt32Display x:Name="Mt32Panel"/>
                <ui:Sc55Display x:Name="Sc55Panel" Visibility="Collapsed"/>
            </Grid>

            <!-- 제목 줄: 설정 / 도움말 (하나를 펼치면 다른 하나는 접힌다. 둘 다 접으면 기기 디자인만 보인다) -->
            <StackPanel Orientation="Horizontal" Margin="4,0,0,12">
                <ToggleButton x:Name="BtnSettings" Content="설정" Style="{StaticResource SectionToggle}"
                              IsChecked="{Binding IsExpanded, ElementName=SecAll, Mode=TwoWay}"/>
                <TextBlock Text="/" Foreground="{StaticResource TextMuted}" FontSize="14" Margin="16,0,16,0"
                           VerticalAlignment="Center"/>
                <ToggleButton x:Name="BtnHelp" Content="도움말" Style="{StaticResource SectionToggle}"
                              IsChecked="{Binding IsExpanded, ElementName=SecHelp, Mode=TwoWay}"/>
            </StackPanel>

            <!-- 설정 전체 -->
            <Expander x:Name="SecAll" Style="{StaticResource BodyOnlyExpander}" Margin="4,0,0,0">
            <StackPanel Margin="0,4,0,12">

            <!-- MT-32 ROM 세트 선택 -->
            <Border x:Name="RomSetCard" Style="{StaticResource Card}" Visibility="Collapsed">
                <Expander x:Name="SecRom" Header="MT-32 ROM 세트" Style="{StaticResource SectionExpander}">
                    <StackPanel>
                    <ComboBox x:Name="RomSetCombo" Margin="0,0,0,10"/>

                    <TextBlock Text="선택한 세트의 ROM 폴더" Style="{StaticResource FieldLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="Mt32RomPathBox" Style="{StaticResource PathBox}"/>
                        <Button Grid.Column="1" Content="찾아보기" Margin="8,0,0,0" Height="34"
                                Click="OnBrowseMt32Rom"/>
                    </Grid>

                    <TextBlock Text="※ 시작 버튼을 눌러야 반영됩니다. 게임마다 요구하는 세트가 다를 수 있습니다(구형 MT-32 / 신형 MT-32 / CM-32L)."
                               Style="{StaticResource HintText}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                </Expander>
            </Border>

            <!-- 채널 → 엔진 배정 -->
            <Border Style="{StaticResource Card}">
                <Expander x:Name="SecChannel" Header="채널 배정 (0-15)" Style="{StaticResource SectionExpander}">
                    <StackPanel>
                    <TextBlock Text="MIDI 종류 (고르면 채널 배정과 기본 엔진이 한 번에 정해집니다)" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="KindCombo" Width="300" HorizontalAlignment="Left"/>
                    <CheckBox x:Name="AutoKindCheck" Margin="0,8,0,14" Foreground="#9A9AA6"
                              Content="들어오는 MIDI(GM On / GS Reset / MTS3 SysEx)를 보고 종류를 자동으로 바꾸기"/>
                    <TextBlock Text="직접 배정" Style="{StaticResource FieldLabel}" Margin="2,0,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Width="80" Margin="0,0,10,0">
                            <TextBlock Text="채널" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="ChannelCombo"/>
                        </StackPanel>
                        <StackPanel Width="220" Margin="0,0,10,0">
                            <TextBlock Text="엔진" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="EngineCombo"/>
                        </StackPanel>
                        <Button Content="배정" VerticalAlignment="Bottom" Height="34" Click="OnAssignChannel"/>
                    </StackPanel>
                    <TextBlock Text="배정하지 않은 채널의 기본 엔진" Style="{StaticResource FieldLabel}" Margin="2,12,0,4"/>
                    <ComboBox x:Name="DefaultEngineCombo" Width="220" HorizontalAlignment="Left"/>

                    <TextBlock Text="※ 맨 위 탭은 화면에 어느 장치를 띄울지만 고릅니다(소리 경로와 무관). 실제 소리는 이 배정과 위의 기본 엔진으로 결정됩니다."
                               Style="{StaticResource HintText}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                </Expander>
            </Border>

            <!-- 포트 설정 -->
            <Border Style="{StaticResource Card}">
                <Expander x:Name="SecMidi" Header="MIDI 포트" Style="{StaticResource SectionExpander}">
                    <StackPanel>
                    <TextBlock Text="가상 입력 포트 (loopMIDI 등)" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="MidiInCombo"/>
                </StackPanel>
                </Expander>
            </Border>

            <!-- SC-55mkII ROM 폴더 -->
            <Border x:Name="Sc55RomCard" Style="{StaticResource Card}" Visibility="Collapsed">
                <Expander x:Name="SecSc55Rom" Header="SC-55mkII ROM 폴더" Style="{StaticResource SectionExpander}">
                    <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="Sc55RomPathBox" Style="{StaticResource PathBox}"/>
                        <Button Grid.Column="1" Content="찾아보기" Margin="8,0,0,0" Height="34"
                                Click="OnBrowseSc55Rom"/>
                    </Grid>
                    <TextBlock Text="※ 이 폴더 안에 rom1.bin / rom2.bin / rom_sm.bin / waverom1.bin / waverom2.bin 이 있어야 합니다."
                               Style="{StaticResource HintText}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                </Expander>
            </Border>

            <!-- 언어 / Language (두 언어로 항상 같게 보인다) -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Language / 언어" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="LanguageCombo"/>
                    <TextBlock Text="※ Applies after restart / 다시 시작하면 적용됩니다."
                               Style="{StaticResource HintText}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 오디오 -->
            <Border Style="{StaticResource Card}">
                <Expander x:Name="SecAudio" Header="오디오" Style="{StaticResource SectionExpander}">
                    <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="44"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="마스터" VerticalAlignment="Center" FontSize="12"/>
                        <Slider x:Name="MasterVolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="80"
                                ValueChanged="OnVolumeChanged"/>
                        <TextBlock x:Name="MasterVolumeText" Grid.Column="2" Text="80" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" FontSize="12"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="44"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="MTS3" VerticalAlignment="Center" FontSize="12"/>
                        <Slider x:Name="Mt32VolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="100"
                                ValueChanged="OnVolumeChanged"/>
                        <TextBlock x:Name="Mt32VolumeText" Grid.Column="2" Text="100" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" FontSize="12"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="44"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="MTS5" VerticalAlignment="Center" FontSize="12"/>
                        <Slider x:Name="Sc55VolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="100"
                                ValueChanged="OnVolumeChanged"/>
                        <TextBlock x:Name="Sc55VolumeText" Grid.Column="2" Text="100" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" FontSize="12"/>
                    </Grid>
                    <Button Content="오디오 출력 다시 시작" Margin="0,12,0,0" HorizontalAlignment="Left"
                            Padding="12,7" Click="OnRestartAudio"/>
                    <TextBlock Text="※ 신호(게이지)는 움직이는데 소리만 안 날 때, 앱을 껐다 켜지 않고 오디오 출력만 다시 여는 버튼입니다."
                               Style="{StaticResource HintText}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                </Expander>
            </Border>

            <!-- 로그 -->
            <Border Style="{StaticResource Card}">
                <Expander x:Name="SecLog" Header="상태" Style="{StaticResource SectionExpander}">
                    <StackPanel>
                    <Border Background="#18181D" CornerRadius="6" Padding="4">
                        <!--
                          로그가 길면 잘려서 정작 필요한 정보(경로 등)를 못 보게 되므로
                          항목마다 자동 줄바꿈되게 합니다. 가로 스크롤은 끕니다.
                        -->
                        <ListBox x:Name="LogList" Height="160" Background="Transparent" Foreground="#9A9AA6"
                                 BorderThickness="0" FontFamily="Consolas" FontSize="12"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                               Foreground="#9A9AA6" FontFamily="Consolas" FontSize="12"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="2,1"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Border>
                </StackPanel>
                </Expander>
            </Border>

            </StackPanel>
            </Expander>

            <!-- 도움말(설정 아래). 처음에는 접혀 있고, 펼침 상태는 기억한다 -->
            <Expander x:Name="SecHelp" IsExpanded="False" Style="{StaticResource BodyOnlyExpander}" Margin="4,0,0,0">
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="빠른 시작" Style="{StaticResource HelpHead}" Margin="0,0,0,5"/>
                        <TextBlock Style="{StaticResource HelpBody}"
                                   Text="1. loopMIDI 같은 프로그램으로 가상 MIDI 포트를 하나 만듭니다.&#x0A;2. 설정 &gt; MIDI 포트에서 그 포트를 &quot;가상 입력 포트&quot;로 고릅니다.&#x0A;3. 쓸 장치 탭(MTS3 / MTS5)을 열고 설정에서 ROM 폴더를 지정합니다.&#x0A;4. [시작]을 누른 뒤 게임이나 시퀀서의 MIDI 출력을 그 포트로 지정합니다.&#x0A;&quot;앱을 켜면 자동으로 시작&quot;에 체크하면 다음부터는 실행만 하면 됩니다."/>

                        <TextBlock Text="화면과 탭" Style="{StaticResource HelpHead}"/>
                        <TextBlock Style="{StaticResource HelpBody}"
                                   Text="맨 위 탭(MTS3 / MTS5)은 화면에 어느 장치를 보여 줄지만 고릅니다. 소리가 어느 장치로 가는지는 설정의 채널 배정이 정합니다. 종료할 때 보던 탭, 창 위치와 크기, 접어 둔 설정 항목을 기억해서 다음 실행 때 그대로 엽니다. 앱은 한 번에 하나만 실행됩니다."/>

                        <TextBlock Text="MIDI 종류와 채널 배정" Style="{StaticResource HelpHead}"/>
                        <TextBlock Style="{StaticResource HelpBody}"
                                   Text="채널 배정에서 MIDI 종류를 고르면 채널 배정과 기본 엔진이 한 번에 정해집니다. 자동 감지를 켜 두면 들어오는 GM On / GS Reset / MTS3 SysEx를 보고 종류를 알아서 바꿉니다. 직접 배정은 채널(0~15)마다 엔진을 따로 정하는 기능이고, 배정하지 않은 채널은 기본 엔진으로 갑니다. MTS3의 소리 파트는 MIDI 채널 2~9(리듬은 10, 1~16 기준)에 있으므로 MTS3로 들으려면 채널 1이 아니라 그쪽 채널을 쓰세요. 배정 화면의 채널 번호는 0~15 기준이라 한 칸씩 작습니다."/>

                        <TextBlock Text="MTS3 화면" Style="{StaticResource HelpHead}"/>
                        <TextBlock Style="{StaticResource HelpBody}"
                                   Text="액정은 엔진이 알려 주는 실기 LCD 글자 그대로입니다(파트 상태와 Vol). 오른쪽 SELECT/VOLUME 노브는 MTS3의 마스터 볼륨(1~100)입니다. 노브를 잡고 원을 그리듯 돌리거나 마우스 휠(한 칸에 2)로 조절하면 액정의 Vol 값도 같이 바뀌고, 게임이 볼륨 SysEx를 보내면 노브가 따라 돕니다. 값은 종료할 때 저장합니다. MIDI MESSAGE 램프는 MIDI를 받을 때 깜박입니다."/>

                        <TextBlock Text="MTS5 화면" Style="{StaticResource HelpHead}"/>
                        <TextBlock Style="{StaticResource HelpBody}"
                                   Text="액정과 버튼은 에뮬레이터 펌웨어가 실제로 처리합니다. 버튼은 왼쪽 클릭 = 누르는 동안 눌림, 오른쪽 클릭 = 눌린 채로 고정(다시 오른쪽 클릭하면 해제), Shift+클릭 = 그 쌍의 ◀▶를 동시에 누름입니다. PART ◀▶로 파트를 고르면 LEVEL, PAN, REVERB, CHORUS, KEY SHIFT, INSTRUMENT, MIDI CH 조정이 그 파트에만 적용됩니다(파트 N = MIDI 채널 N, 파트 10 = 드럼). ALL은 전체 파트, MUTE는 음소거입니다. POWER를 누르면 대기 상태가 되고 다시 누르면 돌아옵니다. VOLUME 노브(1~100)는 MTS5 음량입니다. 게임이 프로그램 체인지나 CC를 보내면 패널에서 바꾼 값을 덮어씁니다. 액정 대비는 PART ◀▶ 동시 누름으로 설정 메뉴에 들어가 ALL/MUTE로 &quot;LCD Contrast&quot;를 고르고 INSTRUMENT ◀▶로 값을 바꾼 뒤 다시 PART ◀▶를 동시에 눌러 확정하며, 값은 저장됩니다."/>

                        <TextBlock Text="볼륨은 세 종류" Style="{StaticResource HelpHead}"/>
                        <TextBlock Style="{StaticResource HelpBody}"
                                   Text="설정 &gt; 오디오의 슬라이더(마스터, MTS3, MTS5)는 이 앱이 소리를 섞어 내보낼 때의 크기입니다. MTS3 화면의 노브는 MTS3 자체의 마스터 볼륨이라 슬라이더와 별개이고, MTS5 화면의 노브는 MTS5 슬라이더와 같은 값입니다."/>

                        <TextBlock Text="소리가 안 날 때" Style="{StaticResource HelpHead}"/>
                        <TextBlock Style="{StaticResource HelpBody}"
                                   Text="설정 아래쪽 &quot;상태&quot; 로그에서 ROM을 찾았는지, MIDI 포트가 열렸는지 먼저 확인하세요. ROM 폴더가 틀리면 &quot;건너뜀&quot; 메시지가 나옵니다. 그다음 [시작]을 눌렀는지, 게임의 MIDI 출력이 같은 가상 포트인지, 그 MIDI 채널이 원하는 엔진으로 배정돼 있는지 확인하세요. 화면의 게이지가 움직이는데 소리가 안 나면 먼저 마스터와 엔진별 볼륨 슬라이더를 보고, 그래도 안 나면 오디오 카드의 &quot;오디오 출력 다시 시작&quot; 버튼을 눌러 보세요(장치를 새로 엽니다)."/>
                    </StackPanel>
                </Border>
            </Expander>

            <Grid>
                <CheckBox x:Name="AutoStartCheck" Content="앱을 켜면 자동으로 시작" Foreground="#9A9AA6"
                          VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <Button Content="시작" Width="120" HorizontalAlignment="Right" Padding="14,10" Click="OnStart"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Window>
